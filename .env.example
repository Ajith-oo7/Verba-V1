# Copy to .env at the repo root. Never commit .env.

# Groq — STT + LLM + fallback TTS
GROQ_API_KEY=
# Prefer a small/fast model for live screens (avoids free-tier 429s from huge prompts)
# Current Groq catalog (verify with /openai/v1/models): qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=350

# Gemini — resume parse, conversation profile, post-call analysis
GEMINI_API_KEY=

# Local LiveKit (--dev keys). Keep these for local Docker.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Next.js
DATABASE_URL=file:./prisma/dev.db
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=replace-with-another-long-random-string

# ElevenLabs — Instant Voice Clone for Cherry (core TTS path)
ELEVEN_LABS_KEY=
# Optional aliases also accepted: ELEVENLABS_API_KEY / ELEVEN_API_KEY
ELEVEN_MODEL=eleven_turbo_v2_5
ELEVEN_STABILITY=0.45
ELEVEN_SIMILARITY=0.85
ELEVEN_STYLE=0.35

# TTS: auto (ElevenLabs clone when key + voice samples exist) | elevenlabs | edge | chatterbox
CHERRY_TTS=auto
CHERRY_EDGE_VOICE=en-US-JennyNeural
CHERRY_EDGE_STYLE=friendly
CHERRY_EDGE_STYLE_DEGREE=1.4
CHERRY_EDGE_RATE=-3%
CHERRY_EDGE_PITCH=+2Hz
# Local Chatterbox fallback (only when CHERRY_TTS=chatterbox or no ElevenLabs key)
CHERRY_CLONE_LOAD_TIMEOUT=8
CHERRY_CLONE_SYNTH_TIMEOUT=20
CHERRY_CLONE_EXAGGERATION=0.55
