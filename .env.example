# Copy to .env at the repo root. Never commit .env.

# Groq — STT + LLM + fallback TTS
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b

# Gemini — resume parse, conversation profile, post-call analysis
GEMINI_API_KEY=

# Local LiveKit (--dev keys). Keep these for local Docker.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Next.js
DATABASE_URL=file:./prisma/dev.db
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=replace-with-another-long-random-string

# TTS: edge (fast, default) | chatterbox (voice clone, slow on CPU) | groq/orpheus
CHERRY_TTS=edge
# Set to 1 only after Chatterbox weights are downloaded and you want clone on calls
CHERRY_CLONE_ENABLED=0
CHERRY_EDGE_FEMALE_VOICE=en-US-JennyNeural
CHERRY_EDGE_MALE_VOICE=en-US-GuyNeural
